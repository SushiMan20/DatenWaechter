{
  "manifest_version": 3,
  "name": "Datenwächter",
  "version": "1.2.0",
  "description": "Prüft Texte und Dateien auf persönliche oder geheime Daten, bevor sie in einen KI-Chat gelangen – komplett lokal.",
  "key": "",
  "icons": {
    "16": "icons/aktiv-16.png",
    "32": "icons/aktiv-32.png",
    "48": "icons/aktiv-48.png",
    "128": "icons/aktiv-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/aktiv-16.png",
      "32": "icons/aktiv-32.png",
      "48": "icons/aktiv-48.png"
    },
    "default_popup": "popup.html",
    "default_title": "Datenwächter – Schutz aktiv"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms",
    "activeTab",
    "contextMenus",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://chat.mistral.ai/*",
        "https://www.perplexity.ai/*"
      ],
      "js": [
        "kategorien.js",
        "vornamen.js",
        "detectors.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://chat.mistral.ai/*",
        "https://www.perplexity.ai/*"
      ],
      "js": [
        "page_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
